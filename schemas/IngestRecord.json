{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbrandexchange.com/schemas/v0.1/IngestRecord.json",
  "type": "object",
  "title": "IngestRecord",
  "description": "GET representation in the Ingest API (and the admin catalog).",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "brand",
        "product",
        "variant",
        "asset"
      ]
    },
    "id": {
      "$ref": "Common.json#/$defs/Id"
    },
    "external_id": {
      "$ref": "Common.json#/$defs/ExternalId"
    },
    "status": {
      "$ref": "Common.json#/$defs/PublicationStatus"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden",
        "pending_files"
      ]
    },
    "etag": {
      "type": "string"
    },
    "created_at": {
      "$ref": "Common.json#/$defs/DateTime"
    },
    "updated_at": {
      "$ref": "Common.json#/$defs/DateTime"
    },
    "data": {
      "type": "object",
      "description": "The stored write model (BrandInput/ProductInput/VariantInput/AssetInput) with defaults applied. For assets 'files' lists the current blobs."
    },
    "missing_files": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "Common.json#/$defs/RenditionName"
      },
      "description": "Assets only: files still required before the asset becomes visible."
    }
  },
  "required": [
    "kind",
    "id",
    "external_id",
    "status",
    "visibility",
    "etag",
    "created_at",
    "updated_at",
    "data"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-[a-z0-9]+-[a-z0-9_-]+$": true
  }
}
