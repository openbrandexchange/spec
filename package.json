{
  "name": "@openbrandexchange/spec",
  "private": true,
  "version": "0.1.0",
  "description": "Open Brand Exchange specification: OpenAPI, JSON Schemas, docs and fixtures.",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "lint": "redocly lint",
    "validate": "node tools/validate.mjs",
    "build:site": "node tools/build-site.mjs",
    "check:site": "node tools/build-site.mjs --check",
    "licenses": "node tools/licenses.mjs",
    "fixtures": "python3 fixtures/generate.py",
    "package": "sh tools/package.sh",
    "check": "npm run lint && npm run validate && npm run licenses && npm run check:site",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.54.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  }
}
