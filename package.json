{
  "name": "@openbrandexchange/spec",
  "private": true,
  "version": "0.2.0",
  "description": "Open Brand Exchange specification: OpenAPI, JSON Schemas, docs and fixtures.",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "lint": "redocly lint",
    "validate": "node tools/validate.mjs",
    "build:site": "node tools/build-site.mjs",
    "check:site": "node tools/build-site.mjs --check",
    "templates": "node tools/templates.mjs",
    "check:templates": "node tools/templates.mjs --check",
    "xlsx-fixtures": "node tools/xlsx-fixtures.mjs",
    "check:xlsx": "node tools/xlsx-fixtures.mjs --check",
    "licenses": "node tools/licenses.mjs",
    "fixtures": "python3 fixtures/generate.py",
    "package": "sh tools/package.sh",
    "check": "npm run lint && npm run validate && npm run licenses && npm run check:site && npm run check:templates && npm run check:xlsx",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@redocly/cli": "2.54.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.3",
      "uuid": "11.1.1"
    }
  }
}
