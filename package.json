{
  "name": "@openbrandexchange/spec",
  "private": true,
  "version": "0.3.0",
  "description": "Open Brand Exchange specification: OpenAPI, JSON Schemas, docs and fixtures.",
  "license": "CC-BY-4.0",
  "type": "module",
  "scripts": {
    "lint": "redocly lint",
    "validate": "bun tools/validate.mjs",
    "build:site": "bun tools/build-site.mjs",
    "check:site": "bun tools/build-site.mjs --check",
    "templates": "bun tools/templates.mjs",
    "check:templates": "bun tools/templates.mjs --check",
    "xlsx-fixtures": "bun tools/xlsx-fixtures.mjs",
    "check:xlsx": "bun tools/xlsx-fixtures.mjs --check",
    "licenses": "bun tools/licenses.mjs",
    "fixtures": "python3 fixtures/generate.py",
    "package": "sh tools/package.sh",
    "check": "bun run lint && bun run validate && bun run licenses && bun run check:site && bun run check:templates && bun run check:xlsx",
    "test:site": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@redocly/cli": "2.79.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "exceljs": "4.4.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "unzipper": "0.12.3",
    "uuid": "11.1.1"
  }
}
